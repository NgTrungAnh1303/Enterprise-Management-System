# PostgreSQL Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=ems_db
MIGRATION_USER=migration_user
MIGRATION_PASSWORD=migration_password_example
APP_USER=app_user
APP_USER_PASSWORD=app_user_password_example
POSTGRES_PASSWORD=postgres_root_password_example

# Spring Boot Backend Configuration
SERVER_PORT=8080
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_length_for_hs256!
JWT_EXPIRATION_MINUTES=30
APP_MAINTENANCE_DUE_SOON_DAYS=7
APP_AUDIT_MANAGER_CAN_VIEW=false
APP_REGISTRATION_ENABLED=true
APP_REGISTRATION_REQUIRE_APPROVAL=true
APP_REGISTRATION_RATE_LIMIT_PER_HOUR=5

# Frontend Configuration
VITE_API_BASE_URL=/api/v1

